/* Noise, layered backgrounds, fog and soft shadows in one small scene. */
@scene {
  group#mountains { cone.peak * 7; }
  sphere#moon;
  torus#halo;
  plane#lake;
}

scene {
  background: noise(3 4, #080b18, #172d55 45%, #b45a78 78%, #f5bc83), linear-gradient(180deg, #182447, #080b18);
  background-blend-mode: screen, normal;
  floor: noise(2 2, #10182b, #273d62 55%, #0b1020);
  camera-distance: 13;
  camera-angle: -18deg 24deg;
  camera-target: 0 1.8 0;
  ambient: 0.22 #879dd1;
  light: -38deg 48deg #ffc98d 1;
  shadows: soft;
  fog: #10182c 5 17;
}

#mountains { translate: 0 0.1 -1.3; }
.peak { --i: sibling-index(); radius: calc(0.65 + mod(var(--i), 3) * 0.28); height: calc(2.2 + mod(var(--i), 4) * 0.65); translate: calc((var(--i) - 4) * 0.85) 0 calc(mod(var(--i), 2) * -0.4); color: noise(2 3, #202d48, #53617d 62%, #b08b8c); material: matte(); }
#moon { radius: 1.05; translate: 2.8 5 -2.5; color: noise(2 3, #d7c8bd, #fff3ce 65%, #b5a2a5); material: matte(); animation: moon 12s ease-in-out alternate; }
#halo { radius: 1.55; thickness: 0.035; rotate-x: 70deg; translate: 2.8 5 -2.5; color: #ffcc91; material: glass(#ffcc91, 1.3, frosted 0.15); }
#lake { size: 10; translate: 0 0.02 0; rotate-x: 90deg; color: displace(linear-gradient(120deg, #182d57, #7da8cf), noise(3 4, #222, #ddd), 0.18); material: glass(1.3, frosted 0.08); }

@keyframes moon { from { translate: 2.8 4.7 -2.5; } to { translate: 2.8 5.2 -2.5; } }
@media (prefers-reduced-motion: reduce) { #moon { animation: none; } }
