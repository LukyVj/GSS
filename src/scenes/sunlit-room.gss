/* A room lit by one shaft of sun, after Maxime Heckel's global illumination study.
   The sun comes in low through a window in the right wall, out of view, and lands on the
   left wall, behind the orange ball. A warm light in front of the ball makes it glow on
   the floor, and a cool one stands for the sky that comes back into the room. */

@scene {
  cube#back;
  cube#left;
  cube#right;
  cube#ceiling;
  cube#window;
  sphere#orange;
  sphere#lime;
  cube#block;
  light#glow;
  light#sky;
}

scene {
  background: #0b0b0d;
  floor: #4f4b47;
  light: 66deg 14deg #fff1dc 4.4;
  ambient: 0.42 #93a3bb;
  shadows: soft;
  fog: #24221f 2 24;
  camera-target: 0 1.5 -0.6;
  camera-distance: 6;
  camera-angle: 0deg 4deg;
  filter: bloom(0.6, 14px) grain(0.07);
}

/* The walls: thick boxes, so the sun only gets in through the window. */
#back,
#left,
#right,
#ceiling {
  color: #6b6560;
  material: matte();
}

#back {
  size: 6.4 4 0.4;
  translate: 0 2 -3.4;
}

#left {
  size: 0.4 4 10;
  translate: -3 2 1.6;
}

#right {
  size: 0.4 4 10;
  translate: 3 2 1.6;
}

#ceiling {
  size: 6.4 0.4 10;
  translate: 0 3.8 1.6;
}

/* Carves the window out of the right wall. */
#window {
  size: 1 2 2.6;
  translate: 3 2.1 0.4;
  operation: subtract;
}

#orange {
  radius: 0.62;
  translate: -1.3 0.62 -2.2;
  color: #ff7a45;
}

#lime {
  radius: 0.36;
  translate: -0.2 0.36 -1.8;
  color: #b9d99a;
}

#block {
  size: 1.4 1.8 1.4;
  translate: 1.5 0.9 -2;
  color: #a9c8e8;
}

/* The glow of the orange ball, on the floor and the left wall. */
#glow {
  translate: -0.9 0.9 -0.3;
  color: #f2701f;
  intensity: 1.1;
}

/* The light of the sky, bounced back into the room, cool and faint. */
#sky {
  translate: 1.6 1.3 0.4;
  color: #bcd6ff;
  intensity: 1.8;
}
