/*
 * LE CHONK
 * The pixel "4" of Mistral AI, in a museum. Click it: it tips over to the left,
 * then falls on its back and bounces once. Click again to replay.
 */

@scene {
  prism#four;
}

scene {
  shadows: soft;
  ambient: 0.35;
  floor: #d8d2c8;
  background: linear-gradient(#5a5048, #2b2622);
  camera-target: 0 1.2 0;
  camera-distance: 8;
  camera-angle: 25deg 14deg;
}

#four {
  /* One cell is 0.35: the horizontal bar, the vertical bar on the right,
     the staircase up to the top, and the small staircase hole inside */
  d: path("M-1.225 0.875 V0.175 H-0.875 V-0.175 H-0.525 V-0.525 H-0.175 V-0.875 H0.175 V-1.225 H0.525 V-1.575 H1.225 V1.575 H0.525 V0.875 Z M-0.175 0.175 V-0.175 H0.175 V-0.525 H0.525 V0.175 Z");
  depth: 0.9;
  translate: 0 1.575 0;
  color: #ff7000;
  texture: url("/textures/mistral-tiles.svg");
  image-rendering: pixelated;
}

/* A press starts the fall; it plays to its end, and the last frame stays */
#four:active {
  animation: fall 2.5s forwards;
}

/* The frames follow the arc: it turns around its center while the center moves
   so that its bottom left corner never leaves the floor, first tipping left,
   then falling on its back, faster and faster, with one bounce */
@keyframes fall {
  0% { rotate-z: -0deg; rotate-x: 0deg; translate: 0 1.575 0; }
  5% { rotate-z: -0.75deg; rotate-x: 0deg; translate: -0.021 1.591 0; }
  10% { rotate-z: -2.62deg; rotate-x: 0deg; translate: -0.073 1.629 0; }
  15% { rotate-z: -5.44deg; rotate-x: 0deg; translate: -0.155 1.684 0; }
  20% { rotate-z: -9.13deg; rotate-x: 0deg; translate: -0.265 1.749 0; }
  25% { rotate-z: -13.64deg; rotate-x: 0deg; translate: -0.406 1.82 0; }
  30% { rotate-z: -18.94deg; rotate-x: 0deg; translate: -0.578 1.887 0; }
  35% { rotate-z: -25deg; rotate-x: 0deg; translate: -0.78 1.945 0; }
  40% { rotate-z: -25deg; rotate-x: 0deg; translate: -0.78 1.945 0; }
  45% { rotate-z: -25deg; rotate-x: 2.62deg; translate: -0.78 1.964 -0.09; }
  50% { rotate-z: -25deg; rotate-x: 8.53deg; translate: -0.78 1.99 -0.293; }
  55% { rotate-z: -25deg; rotate-x: 16.99deg; translate: -0.78 1.992 -0.588; }
  60% { rotate-z: -25deg; rotate-x: 27.7deg; translate: -0.78 1.931 -0.956; }
  65% { rotate-z: -25deg; rotate-x: 40.48deg; translate: -0.78 1.772 -1.37; }
  70% { rotate-z: -25deg; rotate-x: 55.19deg; translate: -0.78 1.48 -1.79; }
  75% { rotate-z: -25deg; rotate-x: 71.72deg; translate: -0.78 1.037 -2.156; }
  80% { rotate-z: -25deg; rotate-x: 90deg; translate: -0.78 0.45 -2.395; }
  84% { rotate-z: -25deg; rotate-x: 84.6deg; translate: -0.78 0.631 -2.344; }
  88% { rotate-z: -25deg; rotate-x: 90deg; translate: -0.78 0.45 -2.395; }
  100% { rotate-z: -25deg; rotate-x: 90deg; translate: -0.78 0.45 -2.395; }
}
