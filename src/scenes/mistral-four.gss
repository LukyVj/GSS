/*
 * LE CHONK
 * The pixel "4" of Mistral AI, in a museum. Click it: it tips over to the left
 * until the end of its bar meets the floor, then falls on its back.
 * The frames are the ones of the film, 25 a second, measured on it.
 */

@scene {
  prism#four;
}

scene {
  shadows: soft;
  ambient: 0.45;
  light: 10deg 55deg;
  floor: #c9c6c1;
  background: linear-gradient(#6b625a, #2b2622);
  camera-target: 0 1.55 -0.5;
  camera-distance: 8.2;
  camera-angle: 0deg 15deg;
}

#four {
  /* 18 cells of 0.19 a side: the leg, the bar that passes the leg by 3 cells,
     the staircase up to the top, the cut top corner, and the stepped hole */
  d: path("M-1.71 0.95 L0.38 0.95 L0.38 1.71 L1.14 1.71 L1.14 0.95 L1.71 0.95 L1.71 0.19 L1.14 0.19 L1.14 -1.52 L0.95 -1.52 L0.95 -1.71 L0 -1.71 L0 -1.52 L-0.19 -1.52 L-0.19 -1.33 L-0.38 -1.33 L-0.38 -1.14 L-0.57 -1.14 L-0.57 -0.95 L-0.76 -0.95 L-0.76 -0.57 L-0.95 -0.57 L-0.95 -0.38 L-1.14 -0.38 L-1.14 -0.19 L-1.33 -0.19 L-1.33 0 L-1.52 0 L-1.52 0.19 L-1.71 0.19 Z M-0.57 0.19 L0.38 0.19 L0.38 -0.95 L0.19 -0.95 L0.19 -0.57 L0 -0.57 L0 -0.38 L-0.19 -0.38 L-0.19 -0.19 L-0.38 -0.19 L-0.38 0 L-0.57 0 Z");
  depth: 0.76;
  translate: 0 1.71 0;
  color: #ef6010;
  texture: url("/textures/mistral-tiles.svg");
  texture-size: 3.42;
  image-rendering: pixelated;
}

/* A press starts the fall; it plays to its end, and the last frame stays */
#four:active {
  animation: fall 3.7s forwards;
}

/* Around the back bottom left corner of the leg: first to the left, slowly,
   faster and faster, until the end of the bar lands; then on its back, with
   one small rebound. Each frame turns the 4 and moves it so that this corner
   stays where it is. */
@keyframes fall {
  0% { rotate-z: -0deg; rotate-x: 0deg; translate: 0 1.71 0; }
  1.081% { rotate-z: -0.038deg; rotate-x: 0deg; translate: -0.001 1.71 0; }
  2.162% { rotate-z: -0.15deg; rotate-x: 0deg; translate: -0.004 1.709 0; }
  3.243% { rotate-z: -0.338deg; rotate-x: 0deg; translate: -0.01 1.708 0; }
  4.324% { rotate-z: -0.601deg; rotate-x: 0deg; translate: -0.018 1.706 0; }
  5.405% { rotate-z: -0.939deg; rotate-x: 0deg; translate: -0.028 1.704 0; }
  6.486% { rotate-z: -1.352deg; rotate-x: 0deg; translate: -0.04 1.701 0; }
  7.568% { rotate-z: -1.84deg; rotate-x: 0deg; translate: -0.055 1.697 0; }
  8.649% { rotate-z: -1.681deg; rotate-x: 0deg; translate: -0.05 1.698 0; }
  9.73% { rotate-z: -1.926deg; rotate-x: 0deg; translate: -0.057 1.696 0; }
  10.811% { rotate-z: -2.153deg; rotate-x: 0deg; translate: -0.064 1.695 0; }
  11.892% { rotate-z: -2.365deg; rotate-x: 0deg; translate: -0.07 1.693 0; }
  12.973% { rotate-z: -2.563deg; rotate-x: 0deg; translate: -0.076 1.691 0; }
