  16.216% { rotate-z: -3.077deg; rotate-x: 0deg; translate: -0.091 1.687 0; }
  17.297% { rotate-z: -3.225deg; rotate-x: 0deg; translate: -0.096 1.686 0; }
  18.378% { rotate-z: -3.364deg; rotate-x: 0deg; translate: -0.1 1.685 0; }
  19.459% { rotate-z: -3.494deg; rotate-x: 0deg; translate: -0.103 1.684 0; }
  20.541% { rotate-z: -3.615deg; rotate-x: 0deg; translate: -0.107 1.683 0; }
  21.622% { rotate-z: -3.73deg; rotate-x: 0deg; translate: -0.11 1.682 0; }
