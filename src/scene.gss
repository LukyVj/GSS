/* GSS test scene
   One zone per feature, placed apart so they never overlap:
     Zone 1 (center)  transforms: translate, rotate, scale, size, classes
     Zone 2 (back)    operations: blend, subtract
     Zone 3 (front)   animations: @keyframes
     Zone 4 (left)    materials: matte, metal, jelly, glass, ice
 */

@scene {
  /* Zone 1: transforms */
  cube#left.corner;
  cube#right.corner;
  cube#top.corner;
  cube#bottom.corner;
  torus#hero;
  torus#big;

  /* Zone 2: operations */
  sphere#drop-a;
  sphere#drop-b;
  cube#box-smooth;
  sphere#hole-smooth;
  cube#box-sharp;
  sphere#hole-sharp;

  /* Zone 3: animations */
  cube#spinner;
  sphere#ball;

  /* Zone 4: materials */
  sphere#m-matte;
  sphere#m-gold;
  sphere#m-chrome;
  sphere#m-jelly;
  sphere#m-glass;
  cube#m-ice;
}

/* ===== Scene settings ===== */

scene {
  floor: #fefefe;
  background: #42429f;
  light: 200deg 10deg;
  ambient: 0.4;
  camera-distance: 14;
  camera-angle: 180deg 45deg;
  camera-spin: 100s;
}

/* ===== Zone 1: transforms (center) ===== */

.corner {
  translate: 0 0.5 0;
  color: #4a90d9;
}

#left {
  translate: -2.5 0.5 0;
}

#right {
  translate: 2.5 0.5 0;
  rotate-y: 45deg;
  color: #ff5a36;
}

#top {
  translate: 0 0.5 2.5;
  size: 1 4 2;
  color: #BADA55;
}

#bottom {
  translate: 0 0.5 -2.5;
}

#hero {
  translate: 0 1.5 0;
  rotate-x: 70deg;
  color: #d4af37;
}

#big {
  translate: 0 4.5 0;
  rotate-x: 70deg;
  scale: 2.0;
  color: #d4af37;
}

/* ===== Zone 2: operations (back, z = -6) ===== */

/* Two drops that merge */
#drop-a {
  translate: -3.4 1 -6;
}

#drop-b {
  translate: -2.6 1.2 -6;
  blend: 0.05;
}

/* A hole with smooth edges */
#box-smooth {
  translate: 0 1 -6;
  size: 1.5;
}

#hole-smooth {
  translate: 0 1 -6;
  radius: 0.95;
  operation: subtract;
  blend: 0.15;
  color: #ff5a36;
}

/* A hole with sharp edges */
#box-sharp {
  translate: 3 1 -6;
  size: 1.5;
  color: #e8e4dc;
}

#hole-sharp {
  translate: 3 1 -6;
  radius: 0.95;
  operation: subtract;
  color: #14bc55;
}

/* ===== Zone 3: animations (front, z = 6) ===== */

/* Rotation, scale and color with from / to */
#spinner {
  translate: -1.5 1 6;
  color: #ff5a36;
  animation: show 3s ease-in-out alternate;
}

@keyframes show {
  from {
    rotate-y: 0deg;
    scale: 1;
  }
  to {
    rotate-y: 180deg;
    scale: 1.4;
    color: #3a7bff;
  }
}

/* Translate with percentages */
#ball {
  translate: 1.5 0.5 6;
  color: #ff5a36;
  animation: float 2s ease-in-out infinite;
}

@keyframes float {
  0% {
    translate: 1.5 0.5 6;
  }
  50% {
    translate: 1.5 2 6;
  }
  100% {
    translate: 1.5 0.5 6;
  }
}

/* ===== Zone 4: materials (left, x = -7) ===== */

#m-matte {
  translate: -7 0.5 -3;
  radius: 0.5;
  color: #ff5a36;
}

#m-gold {
  translate: -7 0.5 -1.8;
  radius: 0.5;
  material: gold;
}

#m-chrome {
  translate: -7 0.5 -0.6;
  radius: 0.5;
  material: chrome;
}

#m-jelly {
  translate: -7 0.5 0.6;
  radius: 0.5;
  color: #ff5a36;
  material: jelly;
}

#m-glass {
  translate: -7 0.6 1.8;
  radius: 0.5;
  material: glass(1.5, hammered 0.3);
}

#m-ice {
  translate: -7 0.6 3;
  size: 0.9;
  material: ice;
}
