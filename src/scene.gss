/* GSS test scene
  One zone per feature, placed apart so they never overlap:
    Zone 1 (center)  transforms: translate, rotate, scale, size, classes
    Zone 2 (back)    operations: blend, subtract
    Zone 3 (front)   animations: @keyframes
    Zone 4 (left)    materials: matte, metal, jelly, glass, ice
    Zone 5 (right)   shapes: cylinder, cone, capsule
    Zone 6 (back right) paths: the GSS logo
    Zone 7 (front left) textures: dirt, grass, ::face(), image-rendering, texture-size
 */

@scene {
  /* Zone 1: transforms */
  cube#left.corner;
  cube#right.corner;
  cube#top.corner;
  cube#bottom.corner;
  torus#hero;
  torus#big;

  /* Zone 2: operations */
  sphere#drop-a;
  sphere#drop-b;
  cube#box-smooth;
  sphere#hole-smooth;
  cube#box-sharp;
  sphere#hole-sharp;

  /* Zone 3: animations */
  cube#spinner;
  sphere#ball;

  /* Zone 4: materials */
  sphere#m-matte;
  sphere#m-gold;
  sphere#m-chrome;
  sphere#m-jelly;
  sphere#m-glass;
  cube#m-ice;

  /* Zone 5: shapes */
  cylinder#s-cylinder;
  cone#s-cone;
  cone#s-shade;
  capsule#s-pill;
  capsule#s-bean;

  /* Zone 6: paths */
  path#logo-left.logo;
  path#logo-right.logo;
  sphere#logo-dot.logo;

  /* Zone 7: textures */
  cube#t-tiles;
  cube#t-grass.grass;
  cube#t-dirt;
  sphere#t-smooth;
}

/* ===== Scene settings ===== */

scene {
  floor: #fefefe;
  background: #42429f;
  light: 200deg 10deg;
  ambient: 0.4;
  camera-distance: 14;
  camera-angle: 180deg 45deg;
  camera-spin: 100s;
}

/* ===== Zone 1: transforms (center) ===== */

.corner {
  translate: 0 0.5 0;
  color: #4a90d9;
}

#left {
  translate: -2.5 0.5 0;
}

#right {
  translate: 2.5 0.5 0;
  rotate-y: 45deg;
  color: #ff5a36;
}

#top {
  translate: 0 0.5 2.5;
  size: 1 4 2;
  color: #BADA55;
}

#bottom {
  translate: 0 0.5 -2.5;
}

#hero {
  translate: 0 1.5 0;
  rotate-x: 70deg;
  color: #d4af37;
}

#big {
  translate: 0 4.5 0;
  rotate-x: 70deg;
  scale: 2.0;
  color: #d4af37;
}

/* ===== Zone 2: operations (back, z = -6) ===== */

/* Two drops that merge */
#drop-a {
  translate: -3.4 1 -6;
}

#drop-b {
  translate: -2.6 1.2 -6;
  blend: 0.05;
}

/* A hole with smooth edges */
#box-smooth {
  translate: 0 1 -6;
  size: 1.5;
}

#hole-smooth {
  translate: 0 1 -6;
  radius: 0.95;
  operation: subtract;
  blend: 0.15;
  color: #ff5a36;
}

/* A hole with sharp edges */
#box-sharp {
  translate: 3 1 -6;
  size: 1.5;
  color: #e8e4dc;
}

#hole-sharp {
  translate: 3 1 -6;
  radius: 0.95;
  operation: subtract;
  color: #14bc55;
}

/* ===== Zone 3: animations (front, z = 6) ===== */

/* Rotation, scale and color with from / to */
#spinner {
  translate: -1.5 1 6;
  color: #ff5a36;
  animation: show 3s ease-in-out alternate;
}

@keyframes show {
  from {
    rotate-y: 0deg;
    scale: 1;
  }
  to {
    rotate-y: 180deg;
    scale: 1.4;
    color: #3a7bff;
  }
}

/* Translate with percentages */
#ball {
  translate: 1.5 0.5 6;
  color: #ff5a36;
  animation: float 2s ease-in-out infinite;
}

@keyframes float {
  0% {
    translate: 1.5 0.5 6;
  }
  50% {
    translate: 1.5 2 6;
  }
  100% {
    translate: 1.5 0.5 6;
  }
}

/* ===== Zone 4: materials (left, x = -7) ===== */

#m-matte {
  translate: -7 0.5 -3;
  radius: 0.5;
  color: #ff5a36;
}

#m-gold {
  translate: -7 0.5 -1.8;
  radius: 0.5;
  material: gold;
}

#m-chrome {
  translate: -7 0.5 -0.6;
  radius: 0.5;
  material: chrome;
}

#m-jelly {
  translate: -7 0.5 0.6;
  radius: 0.5;
  color: #ff5a36;
  material: jelly;
}

#m-glass {
  translate: -7 0.6 1.8;
  radius: 0.5;
  material: glass(1.5, hammered 0.3);
}

#m-ice {
  translate: -7 0.6 3;
  size: 0.9;
  material: ice;
}

/* ===== Zone 5: shapes (right, x = 7) ===== */

#s-cylinder {
  translate: 7 0.5 -3;
  radius: 0.4;
  height: 1.6;
}

#s-cone {
  translate: 7 0.5 -1.5;
  radius: 0.5;
  height: 1.2;
  color: #3ad16b;
}

#s-shade {
  translate: 7 0.5 0;
  radius: 0.6 0.3;
  height: 0.8;
  material: gold;
}

#s-pill {
  translate: 7 0.5 1.5;
  radius: 0.25;
  height: 1.4;
  color: #ff5a36;
  material: jelly;
}

#s-bean {
  translate: 7 0.5 3;
  radius: 0.35;
  height: 1.2;
  rotate-x: 90deg;
  material: chrome;
}

/* ===== Zone 6: paths (back right, x = 7, z = -6) ===== */
/* The GSS logo, drawn with two paths: see src/playground/logo.gss */

.logo {
  translate: 7 1.3 -6;
}

path.logo {
  view-box: 0 0 32 32;
  stroke-width: 2.4;
  scale: 0.1;
}

#logo-left {
  d: path("M12.5 4.5C9.5 4.5 9 6 9 8.5v4c0 2-1 3.5-3.5 3.5C8 16 9 17.5 9 19.5v4c0 2.5.5 4 3.5 4");
}

#logo-right {
  d: path("M19.5 4.5C22.5 4.5 23 6 23 8.5v4c0 2 1 3.5 3.5 3.5C24 16 23 17.5 23 19.5v4c0 2.5-.5 4-3.5 4");
}

#logo-dot {
  radius: 0.46;
  color: #ff5a36;
  material: jelly(0.6);
}

/* ===== Zone 7: textures (front left, x = -7, z = 6) ===== */
/* The images are in public/textures: 16×16, drawn for GSS */

/* A floor of small tiles: texture-size repeats the image */
#t-tiles {
  translate: -7 0.05 6;
  size: 3 0.1 3;
  texture: url("/textures/dirt.png");
  texture-size: 0.5;
  image-rendering: pixelated;
}

/* The grass block: an image for the sides, the top and the bottom */
.grass {
  texture: url("/textures/grass-side.png");
  image-rendering: pixelated;
}

.grass::top {
  texture: url("/textures/grass-top.png");
}

.grass::bottom {
  texture: url("/textures/dirt.png");
}

#t-grass {
  translate: -7.7 0.6 5.4;
}

/* The same dirt, pixelated on a cube and smooth on a sphere (cut like the cube around it) */
#t-dirt {
  translate: -6.3 0.6 5.4;
  rotate-y: 20deg;
  texture: url("/textures/dirt.png");
  image-rendering: pixelated;
}

/* One face of its own: it turns with the cube */
#t-dirt::face(front) {
  texture: url("/textures/grass-top.png");
}

#t-smooth {
  translate: -7 0.6 6.8;
  radius: 0.5;
  texture: url("/textures/dirt.png");
}
