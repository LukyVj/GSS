/* My first scene compiled by GSS */

@scene {
  cube#left.corner;
  cube#right.corner;
  cube#top.corner;
  cube#bottom.corner;
  torus#hero;
  sphere#big;

  /* box and hole */
  cube#box; sphere#hole;

  /* two drops that merge */
  sphere#a; sphere#b; cube#box; sphere#hole;
}

@scene { sphere#ball; }
#ball { color: #ff5a36; animation: float 2s ease-in-out infinite alternate; }
@keyframes float {
  from { translate: 1 0.5 0; }
  to   { translate: 3 2 0; }
}

/* 1. Two drops that merge */
#a { translate: -3.4 1 0; }
#b { translate: -2.6 1.2 0; blend: 0.05; }

/* 2. A hole with smooth edges */
#box  { translate: 0 1 0; size: 1.5; }
#hole { translate: 0 1 0; radius: 0.95; operation: subtract; blend: 0.15; color: #ff5a36; }

#box  { translate: 2 1 0; size: 1.5; color: #e8e4dc; }
#hole { translate: 2 1 0; radius: 0.95; color:#14bc55; operation: subtract; }

scene {
  floor: #fefefe;
  background:#42429f;
  light: 200deg 10deg;
  ambient: 0.4;
  camera-distance: 12;
  camera-angle: 180deg 45deg;
  camera-spin: 100s;
}

#right {
  color: #ff5a36;
}

.corner {
  translate: 0 0.5 0;
  color: #4a90d9;
}

#left {
  translate: -2.5 0.5 0;
}

#right {
  translate: 2.5 0.5 0;
  rotate-y: 45deg;
}

#top {
  translate:  0 0.5 2.5;
  color: #BADA55;
  size: 1 4 2;
}

#bottom {
  translate:  0 0.5 -2.5;
}

#hero {
  translate: 0 1.5 0;
  color: #d4af37;
  rotate-x: 70deg;
}

#big {
  translate: 0 4.5 0;
  color: #d4af37;
  rotate-x: 70deg;
  scale: 2.0;
}
