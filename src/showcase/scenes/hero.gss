/* Developers: a hero that answers the mouse, with no Three.js.
   Hover a pillar: it rises. */

@scene {
  capsule.pillar * 7;
}

scene {
  background: #0a0a0c;
  floor: #111114;
  camera-distance: 7.5;
  camera-angle: 0deg 14deg;
  camera-target: 0 0.9 0;
}

.pillar {
  --i: sibling-index();
  radius: 0.22;
  height: 1.4;
  translate: calc(var(--i) * 0.75 - 3) 0.7 0;
  color: #e8e6e1;
}

.pillar:hover {
  translate: calc(var(--i) * 0.75 - 3) 1.3 0;
  color: #ff5a36;
}
