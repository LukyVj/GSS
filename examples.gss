/* Tree */
@scene {
  cone#tree * 10 cylinder#trunk
}

#trunk {
  radius: 0.04;
  height: 0.5;
  color: #826032
}

cone {
  radius: calc(sibling-index()/10 * 0.2);
  height: calc(sibling-index()/10 * 0.2);
  translate: 0 calc(0.8 - 0.005 * sibling-index() * (sibling-index() + 1)) 0;
  color: #BADA55;
}

/* City */
@scene {
  box#building * 10;
  cylinder#tower
}

#tower {
  radius: 0.04;
  height: 0.5;
  color: #826032
}

/* Dirt block: the same image, pixelated on the left, smooth on the right */
@scene {
  cube#dirt;
  cube#smooth
}

cube {
  texture: url("/textures/dirt.png");
}

#dirt {
  translate: -0.7 0.5 0;
  image-rendering: pixelated;
}

#smooth {
  translate: 0.7 0.5 0;
}

/* Grass block: an image for the sides, the top and the bottom */
@scene {
  cube.grass
}

.grass {
  translate: 0 0.5 0;
  texture: url("/textures/grass-side.png");
  image-rendering: pixelated;
}

.grass::top {
  texture: url("/textures/grass-top.png");
}

.grass::bottom {
  texture: url("/textures/dirt.png");
}
