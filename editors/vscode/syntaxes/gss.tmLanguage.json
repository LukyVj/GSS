{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "scopeName": "source.gss",
  "name": "GSS",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#at-scene"
    },
    {
      "include": "#at-keyframes"
    },
    {
      "include": "#at-property-panel"
    },
    {
      "include": "#at-property"
    },
    {
      "include": "#at-paint"
    },
    {
      "include": "#selector"
    },
    {
      "include": "#rule-block"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.block.gss",
      "begin": "/\\*",
      "end": "\\*/",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.comment.begin.gss"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.comment.end.gss"
        }
      }
    },
    "at-scene": {
      "comment": "@scene { cube#hero.big * 3; } : only selectors inside",
      "begin": "(@)(scene)\\b",
      "beginCaptures": {
        "0": {
          "name": "keyword.control.at-rule.scene.gss"
        },
        "1": {
          "name": "punctuation.definition.keyword.gss"
        }
      },
      "end": "(?<=\\})",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.scene.begin.bracket.curly.gss"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.scene.end.bracket.curly.gss"
            }
          },
          "patterns": [
            {
              "include": "#comment"
            },
            {
              "include": "#selector"
            },
            {
              "match": "\\*",
              "name": "keyword.operator.arithmetic.multiply.gss"
            },
            {
              "include": "#number"
            },
            {
              "match": ";",
              "name": "punctuation.terminator.instance.gss"
            }
          ]
        }
      ]
    },
    "at-keyframes": {
      "comment": "@keyframes name { from { ... } 50% { ... } }",
      "begin": "(@)(keyframes)\\b\\s*(-?[a-zA-Z_][\\w-]*|--[\\w-]+)?",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.keyword.gss"
        },
        "0": {
          "name": "keyword.control.at-rule.keyframes.gss"
        },
        "3": {
          "name": "entity.name.function.keyframes.gss"
        }
      },
      "end": "(?<=\\})",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.keyframes.begin.bracket.curly.gss"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.keyframes.end.bracket.curly.gss"
            }
          },
          "patterns": [
            {
              "include": "#comment"
            },
            {
              "match": "\\b(from|to)\\b",
              "name": "entity.other.keyframe-offset.gss"
            },
            {
              "match": "(?<![\\w-])\\d+(?:\\.\\d+)?%",
              "name": "entity.other.keyframe-offset.percentage.gss"
            },
            {
              "match": ",",
              "name": "punctuation.separator.list.comma.gss"
            },
            {
              "include": "#rule-block"
            }
          ]
        }
      ]
    },
    "at-property-panel": {
      "comment": "@property-panel { display: open; }: before at-property, which would stop at the hyphen",
      "begin": "(@)(property-panel)(?![\\w-])",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.keyword.gss"
        },
        "0": {
          "name": "keyword.control.at-rule.property-panel.gss"
        }
      },
      "end": "(?<=\\})",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#rule-block"
        }
      ]
    },
    "at-property": {
      "comment": "@property --speed { syntax: \"<number>\"; inherits: false; initial-value: 4; }",
      "begin": "(@)(property)(?![\\w-])\\s*(--[\\w-]+)?",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.keyword.gss"
        },
        "0": {
          "name": "keyword.control.at-rule.property.gss"
        },
        "3": {
          "name": "variable.other.custom-property.gss"
        }
      },
      "end": "(?<=\\})",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#rule-block"
        }
      ]
    },
    "selector": {
      "patterns": [
        {
          "match": "(@)(media)\\b",
          "captures": {
            "1": {
              "name": "punctuation.definition.keyword.gss"
            },
            "2": {
              "name": "keyword.control.at-rule.media.gss"
            }
          }
        },
        {
          "match": "&",
          "name": "entity.name.tag.nesting.gss"
        },
        {
          "match": "(#)[\\w-]+",
          "name": "entity.other.attribute-name.id.gss",
          "captures": {
            "1": {
              "name": "punctuation.definition.entity.gss"
            }
          }
        },
        {
          "match": "(\\.)[\\w-]+",
          "name": "entity.other.attribute-name.class.gss",
          "captures": {
            "1": {
              "name": "punctuation.definition.entity.gss"
            }
          }
        },
        {
          "match": "(:)[\\w-]+",
          "name": "entity.other.attribute-name.pseudo-class.gss",
          "captures": {
            "1": {
              "name": "punctuation.definition.entity.gss"
            }
          }
        },
        {
          "match": "(?<![\\w-])[a-zA-Z_][\\w-]*",
          "name": "entity.name.tag.gss"
        },
        {
          "match": ",",
          "name": "punctuation.separator.list.comma.gss"
        },
        {
          "match": "[>+~]",
          "name": "keyword.operator.combinator.gss"
        }
      ]
    },
    "rule-block": {
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.property-list.begin.bracket.curly.gss"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.property-list.end.bracket.curly.gss"
        }
      },
      "name": "meta.property-list.gss",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#nested-rule"
        },
        {
          "include": "#declaration"
        }
      ]
    },
    "declaration": {
      "begin": "(-?[a-zA-Z_][\\w-]*|--[\\w-]+)\\s*(:)",
      "beginCaptures": {
        "1": {
          "name": "support.type.property-name.gss"
        },
        "2": {
          "name": "punctuation.separator.key-value.gss"
        }
      },
      "end": "(;)|(?=\\})",
      "endCaptures": {
        "1": {
          "name": "punctuation.terminator.rule.gss"
        }
      },
      "contentName": "meta.property-value.gss",
      "patterns": [
        {
          "include": "#value"
        }
      ]
    },
    "value": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#string"
        },
        {
          "match": "(#)[0-9a-fA-F]{3,8}\\b",
          "name": "constant.other.color.rgb-value.hex.gss",
          "captures": {
            "1": {
              "name": "punctuation.definition.constant.gss"
            }
          }
        },
        {
          "include": "#number"
        },
        {
          "begin": "(-?[a-zA-Z_][\\w-]*|--[\\w-]+)(\\()",
          "end": "\\)",
          "beginCaptures": {
            "1": {
              "name": "support.function.gss"
            },
            "2": {
              "name": "punctuation.section.function.begin.bracket.round.gss"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.function.end.bracket.round.gss"
            }
          },
          "patterns": [
            {
              "include": "#value"
            }
          ]
        },
        {
          "match": "(?<![\\w-])(?:-?[a-zA-Z_][\\w-]*|--[\\w-]+)",
          "name": "support.constant.property-value.gss"
        },
        {
          "match": ",",
          "name": "punctuation.separator.list.comma.gss"
        },
        {
          "match": "[+*/]|(?<=\\s)-(?=\\s)",
          "name": "keyword.operator.arithmetic.gss"
        }
      ]
    },
    "number": {
      "match": "(?<![\\w#-])(-?(?:\\d+(?:\\.\\d+)?|\\.\\d+))([a-zA-Z]+|%)?",
      "captures": {
        "1": {
          "name": "constant.numeric.gss"
        },
        "2": {
          "name": "keyword.other.unit.gss"
        }
      }
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.double.gss",
          "begin": "\"",
          "end": "\"|$",
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.gss"
            }
          ]
        },
        {
          "name": "string.quoted.single.gss",
          "begin": "'",
          "end": "'|$",
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.gss"
            }
          ]
        }
      ]
    },
    "nested-rule": {
      "begin": "(?=[^;{}]*\\{)",
      "end": "(?<=\\})",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#selector"
        },
        {
          "include": "#rule-block"
        }
      ]
    },
    "at-paint": {
      "comment": "@paint name { …GLSL… }: a texture drawn by a fragment shader; the block is GLSL",
      "begin": "(@)(paint)\\b\\s*(-?[a-zA-Z_][\\w-]*)?",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.keyword.gss"
        },
        "0": {
          "name": "keyword.control.at-rule.paint.gss"
        },
        "3": {
          "name": "entity.name.function.paint.gss"
        }
      },
      "end": "(?<=\\})",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.paint.begin.bracket.curly.gss"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.paint.end.bracket.curly.gss"
            }
          },
          "contentName": "meta.embedded.block.glsl",
          "patterns": [
            {
              "include": "#glsl"
            }
          ]
        }
      ]
    },
    "glsl": {
      "comment": "GLSL inside @paint: braces counted, comments, preprocessor, keywords, types, numbers, gl_ names, calls",
      "patterns": [
        {
          "name": "comment.line.double-slash.glsl",
          "match": "//.*$"
        },
        {
          "name": "comment.block.glsl",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "begin": "\\{",
          "end": "\\}",
          "patterns": [
            {
              "include": "#glsl"
            }
          ]
        },
        {
          "name": "keyword.control.directive.glsl",
          "match": "^\\s*#\\s*\\w+"
        },
        {
          "name": "storage.type.glsl",
          "match": "\\b(void|bool|int|uint|float|[biu]?vec[234]|mat[234](x[234])?|sampler[23]D|samplerCube|struct)\\b"
        },
        {
          "name": "storage.modifier.glsl",
          "match": "\\b(uniform|in|out|inout|const|attribute|varying|precision|highp|mediump|lowp)\\b"
        },
        {
          "name": "keyword.control.glsl",
          "match": "\\b(if|else|for|while|do|return|break|continue|discard)\\b"
        },
        {
          "name": "constant.language.glsl",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.numeric.glsl",
          "match": "\\b(\\d+\\.?\\d*|\\.\\d+)([eE][-+]?\\d+)?[fu]?\\b"
        },
        {
          "name": "variable.language.glsl",
          "match": "\\bgl_\\w+\\b"
        },
        {
          "name": "entity.name.function.glsl",
          "match": "\\b[A-Za-z_]\\w*(?=\\s*\\()"
        }
      ]
    }
  }
}
